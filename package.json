{
  "name": "@weibaohui/context-razor",
  "version": "0.4.5",
  "description": "dsh 插件 · 上下文剃刀：把当前会话上下文逐条列出（角色/预览/≈token/占比，cl100k 估算），类型筛选与超阈值标红一眼锁定大头，勾选后精确裁剪——不经 LLM 总结，删了什么一目了然。",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "context",
    "token",
    "trim",
    "razor",
    "dsh-plugin"
  ],
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./client/bundle.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.5",
    "dsh": ">=0.1.7-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "src",
    "client",
    "docs",
    "cordis.patch.yml"
  ],
  "scripts": {
    "check": "node --check src/index.js && node --check client/index.js",
    "test": "node --test test/*.test.mjs",
    "build:client": "node scripts/build-client.mjs",
    "prepublishOnly": "npm run build:client && npm run check && npm test"
  },
  "dependencies": {
    "js-tiktoken": "^1.0.21"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weibaohui/context-razor.git"
  },
  "homepage": "https://github.com/weibaohui/context-razor#readme",
  "bugs": {
    "url": "https://github.com/weibaohui/context-razor/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
